---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

import Footer from '../components/Footer.astro';
import PepSearch from '../components/PepSearch.svelte';

const pepFiles = readdirSync(join(process.cwd(), 'public', 'data'))
	.filter((name) => /^\d{6}_pep\.parquet$/.test(name))
	.sort();
const latestPepFile = pepFiles.at(-1);

if (!latestPepFile) {
	throw new Error('Nenhum snapshot PEP encontrado em public/data');
}

const ym = latestPepFile.slice(0, 6);
const periodIso = `${ym.slice(0, 4)}-${ym.slice(4, 6)}`;
const periodLabel = new Intl.DateTimeFormat('pt-BR', {
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
}).format(new Date(`${periodIso}-01T00:00:00Z`));
const parquetUrl = `${import.meta.env.BASE_URL}data/${latestPepFile}`;
const sourceUrl = `https://portaldatransparencia.gov.br/download-de-dados/pep/${ym}`;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width,initial-scale=1" />
	<title>Busca de PEP | Quem São Eles?</title>
	<meta name="description" content={`Busca na base aberta de Pessoas Expostas Politicamente da CGU — competência ${periodLabel}.`} />
	<style>
		:root {
			--font-main: "Georgia", serif;
			--font-sans: "Helvetica Neue", Helvetica, Arial, sans-serif;
			--bg-color: #fcfcfc;
			--text-color: #111;
			--link-color: #000;
			--link-hover: #555;
			--border-color: #ddd;
		}
		body {
			font-family: var(--font-main);
			background-color: var(--bg-color);
			color: var(--text-color);
			line-height: 1.6;
			margin: 0;
			padding: 0;
		}
		header.site-header {
			border-bottom: 2px solid #000;
			padding: 2rem 1rem;
			text-align: center;
			background: #fff;
		}
		header.site-header h1 {
			font-size: 2.5rem;
			font-weight: bold;
			margin: 0;
			text-transform: uppercase;
			letter-spacing: -1px;
		}
		header.site-header p {
			font-family: var(--font-sans);
			font-size: 1.1rem;
			color: #555;
			margin: 0.5rem 0 0 0;
		}
		main {
			max-width: 900px;
			margin: 2rem auto;
			padding: 0 1rem;
		}
		.back-link {
			font-family: var(--font-sans);
			display: inline-block;
			margin-bottom: 1rem;
			text-decoration: none;
			color: #555;
			font-weight: bold;
		}
		.back-link:hover,
		.back-link:focus-visible {
			text-decoration: underline;
			color: #000;
		}
		.dataset-context {
			border-block: 1px solid var(--border-color);
			font-family: var(--font-sans);
			margin-bottom: 2rem;
			padding: 1rem 0;
		}
		.dataset-context h2 {
			font-family: var(--font-main);
			font-size: 1.1rem;
			margin: 0 0 0.75rem;
		}
		.dataset-context dl {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: 0.25rem 0.75rem;
			margin: 0;
		}
		.dataset-context dt {
			font-weight: 700;
		}
		.dataset-context dd {
			margin: 0;
		}
		.dataset-context a {
			color: inherit;
		}
		@media (max-width: 520px) {
			.dataset-context dl {
				grid-template-columns: 1fr;
				gap: 0.1rem;
			}
			.dataset-context dd {
				margin-bottom: 0.65rem;
			}
		}
	</style>
</head>
<body>
	<header class="site-header">
		<h1>Catálogo PEP</h1>
		<p>Busca em dados abertos de Pessoas Expostas Politicamente</p>
	</header>

	<main>
		<a href={import.meta.env.BASE_URL} class="back-link">← Voltar à página inicial</a>

		<aside class="dataset-context" aria-labelledby="dataset-context-title">
			<h2 id="dataset-context-title">Base consultada</h2>
			<dl>
				<dt>Origem</dt>
				<dd><a href={sourceUrl} target="_blank" rel="noopener noreferrer">Portal da Transparência / CGU</a></dd>
				<dt>Competência</dt>
				<dd><time datetime={periodIso}>{periodLabel}</time></dd>
				<dt>Arquivo</dt>
				<dd><a href={parquetUrl}>{latestPepFile}</a></dd>
			</dl>
		</aside>

		<div style="font-family: var(--font-sans);">
			<PepSearch client:only="svelte" parquetUrl={parquetUrl} dataPeriod={periodLabel} />
		</div>
	</main>
	<Footer />
</body>
</html>