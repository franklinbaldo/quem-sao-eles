---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Quem São Eles?</p>
	<p><a href="https://github.com/franklinbaldo/quem-sao-eles">Código e dados no GitHub</a></p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0.35rem 0;
	}
	footer a {
		color: inherit;
	}
	footer a:hover,
	footer a:focus-visible {
		color: rgb(var(--gray-dark));
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.18em;
	}
</style>
